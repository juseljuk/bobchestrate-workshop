# Confluent Cloud Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_API_KEY=your_kafka_api_key
KAFKA_API_SECRET=your_kafka_api_secret

# Kafka Topic Configuration
KAFKA_TOPIC=fashion.inventory.events
KAFKA_GROUP_ID=fashion-inventory-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest

# Schema Registry Configuration
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-1.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=your_schema_registry_api_key
SCHEMA_REGISTRY_API_SECRET=your_schema_registry_api_secret

# Alert Topic Configuration
ALERT_TOPIC=fashion.velocity.anomalies
ALERT_CONSUMER_GROUP_ID=velocity-alert-consumer-group

# Watsonx Orchestrate Configuration (Required for agent integration)
WXO_INSTANCE_URL=https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/your-instance-id
WXO_AGENT_ID_OR_NAME=your-agent-id-or-name
WXO_AUTH_URL=https://iam.cloud.ibm.com/identity/token
WXO_API_KEY=your_wxo_api_key
WXO_INSTANCE_CLOUD=ibmcloud
WXO_TIMEOUT_SECONDS=60

# Agent Response Topic
AGENT_RESPONSE_TOPIC=fashion.agent.responses